{
  "name": "@rtds/tokens",
  "version": "0.1.0",
  "description": "Design tokens for the RTDS design system",
  "type": "module",
  "main": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/js/index.js"
    },
    "./atlas.css": "./dist/atlas.css",
    "./folio.css": "./dist/folio.css",
    "./maison.css": "./dist/maison.css",
    "./playground.css": "./dist/playground.css",
    "./css": "./dist/css/variables.css",
    "./css/*": "./dist/css/*",
    "./themes/*": "./dist/*"
  },
  "files": [
    "dist",
    "themes",
    "theme.rtds.schema.json"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.js && tsc",
    "migrate:hex": "node scripts/migrate-hex-to-oklch.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint for tokens'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
